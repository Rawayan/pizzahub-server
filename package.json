
{
  "name": "pizzahub-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express.js API server for the PizzaHub platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
